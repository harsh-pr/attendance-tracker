rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --------------------------------------------------------------------------
    // User Isolation Rule
    // Each authenticated user can only read, create, update, or delete their own
    // subcollections and documents under /users/{userId}
    // --------------------------------------------------------------------------
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --------------------------------------------------------------------------
    // Temporary Shared Timetables
    // - Authenticated users can generate a share code.
    // - Knowing the exact 6-character code allows reading (get) the share document.
    // - Collection enumeration (list) is strictly forbidden to prevent harvesting.
    // - Updates are forbidden to guarantee data integrity.
    // --------------------------------------------------------------------------
    match /temp_shared_timetables/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.code == code
                    && request.resource.data.expiresAt is number
                    && request.resource.data.createdAt is number
                    && request.resource.data.payload != null;
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
